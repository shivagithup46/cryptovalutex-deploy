# CryptoVaultX Backend Environment Variables
# Copy this file to .env and replace the values appropriately

# JWT Secret for signing authentication tokens
# Must be at least 256 bits (32 characters) long
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database configuration (Optional, defaults to H2 memory database)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cryptovaultx
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=password

# Redis configuration (Optional, defaults to localhost:6379)
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379

# Kafka configuration (Optional, defaults to localhost:9092)
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
